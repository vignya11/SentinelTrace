# Copy to .env or set as environment variables. NEVER commit real values.
SENTINEL_ENV=development            # development | demo | production
# Required in production (>=32 chars):  python -c "import secrets;print(secrets.token_hex(32))"
SENTINEL_SECRET_KEY=
# Keep the checkpoint key and external anchor OUTSIDE the repo and OUTSIDE the database folder:
SENTINEL_CHECKPOINT_KEY=
SENTINEL_CHECKPOINT_EXTERNAL=       # e.g. D:\anchors\sentineltrace-checkpoints.jsonl (separate disk / WORM / another host)
SENTINEL_INGEST_TOKEN=              # leave empty to disable the ingest API
SENTINEL_DB=
SENTINEL_EVIDENCE_DIR=
SENTINEL_REGISTRATION=false
SENTINEL_SIMULATOR=false            # true only in demo/dev; produces labelled synthetic events
SENTINEL_RECOVERY=none              # none | file (dev outbox, no email is sent)
SENTINEL_TRUSTED_PROXIES=0          # number of reverse proxies in front (enables X-Forwarded-* handling)
SENTINEL_COOKIE_SECURE=             # defaults to true in production
